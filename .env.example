POSTGRES_DB=hackathon_judge
POSTGRES_USER=judge
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://judge:change-this-local-password@localhost:5432/hackathon_judge
REDIS_URL=redis://localhost:6379/0
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
EVIDENCE_DIR=./backend/evidence
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JUDGE_ENCRYPTION_KEY=
# Optional Google Gemini API provider. Leave LLM_PROVIDER=none until a key is configured.
LLM_PROVIDER=none
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Generate a long random value. Used to sign secure session cookies.
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=false
# Create a Google OAuth Web Application client and register the callback URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
